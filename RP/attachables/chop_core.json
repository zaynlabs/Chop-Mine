{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "chopmine:chop_core",
      "item": {
        "chopmine:chop_core": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/chop_core",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.chop_core"
      },
      "animations": {
        "idle": "animation.chop_core.idle",
        "hold_third_person": "animation.chop_core.hold_third_person",
        "hold_first_person": "animation.chop_core.hold_first_person"
      },
      "scripts": {
        "animate": [
          "idle",
          { "hold_third_person": "!context.is_first_person" },
          { "hold_first_person": "context.is_first_person" }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
